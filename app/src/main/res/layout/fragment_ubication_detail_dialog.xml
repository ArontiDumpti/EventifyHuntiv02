<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.UbicationDetailDialogFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/tbUbicationDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnCloseUbicationDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Close" />
            </RelativeLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/dark_dark_navbar">

            <!-- CABECERA -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="200dp">

                <!-- TÍTULO -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/auditorio_unspek"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/black"
                    android:alpha="0.6"/>

                <!-- TÍTULO -->
                <TextView
                    android:id="@+id/tvTituloUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:fontFamily="@font/lexend"
                    android:text="CENTRO DE CONVENCIONES
                    UNS"
                    android:textColor="@color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"/>

                <!-- SUBTÍTULO -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTituloUbicacion"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:fontFamily="@font/lexend"
                    android:text="Av. Universitaria 1234, Nuevo Chimbote"
                    android:textColor="@color/white"
                    android:textSize="14sp"/>

            </RelativeLayout>

            <!-- CARDVIEW 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvUbicationAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/ColorAccent"
                app:strokeWidth="2dp"
                android:outlineAmbientShadowColor="@color/ColorAccent"
                android:outlineSpotShadowColor="@color/ColorAccent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">


                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/aro_perfil"
                        android:padding="5dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_flechaenviar">
                        </ImageView>
                    </FrameLayout>



                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lexend"
                            android:text="Av. Universitaria S/N, Nuevo Chimbote 02712"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>



                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_flecha_derecha"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARDVIEW 2 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvUbicationPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/ColorAccent"
                app:strokeWidth="2dp"
                android:outlineAmbientShadowColor="@color/ColorAccent"
                android:outlineSpotShadowColor="@color/ColorAccent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/aro_perfil"
                        android:padding="5dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_telefono">
                        </ImageView>
                    </FrameLayout>


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Llamar +51 960 301 255"
                            android:textColor="#111827"
                            android:fontFamily="@font/lexend"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_flecha_derecha"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARDVIEW 3 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvUbicationWeb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/ColorAccent"
                app:strokeWidth="2dp"
                android:outlineAmbientShadowColor="@color/ColorAccent"
                android:outlineSpotShadowColor="@color/ColorAccent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/aro_perfil"
                        android:padding="5dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_web">
                        </ImageView>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="www.uns.edu.pe"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:fontFamily="@font/lexend"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_flecha_derecha"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="250dp"
                android:src="@drawable/ventifypng"/>



        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
