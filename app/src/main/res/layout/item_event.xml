<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1AFFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#1AFFFFFF"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Main Container for the Event Card -->
    <!-- Designed with a modern, glassmorphic look: semi-transparent background and subtle borders -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Event Thumbnail Image -->
        <!-- Each event gets a rounded thumbnail for better visual recognition -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvEventImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivEventThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_eventify" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Category Tag (e.g., IA, KOTLIN) -->
        <!-- The tag helps users quickly identify the event topic -->
        <TextView
            android:id="@+id/tvEventTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/aro_perfil"
            android:backgroundTint="#226837CE"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="#ECE3FF"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cvEventImage"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="KOTLIN" />



        <!-- Event Title -->
        <TextView
            android:id="@+id/tvEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivArrow"
            app:layout_constraintStart_toStartOf="@id/tvEventTag"
            app:layout_constraintTop_toBottomOf="@id/tvEventTag"
            tools:text="Kotlin Multiplatform Workshop" />

        <!-- Speaker Section -->
        <LinearLayout
            android:id="@+id/llSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tvEventTitle"
            app:layout_constraintStart_toStartOf="@id/tvEventTitle"
            app:layout_constraintTop_toBottomOf="@id/tvEventTitle">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:alpha="0.6"
                android:src="@drawable/ic_persona"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvEventSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:textColor="@color/white"
                android:textSize="13sp"
                tools:text="Sofia Vega" />
        </LinearLayout>

        <!-- Date and Time Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/tvEventTitle"
            app:layout_constraintStart_toStartOf="@id/tvEventTitle"
            app:layout_constraintTop_toBottomOf="@id/llSpeaker">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:alpha="0.6"
                android:src="@drawable/ic_calendar"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="15/05/2026" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="16dp"
                android:alpha="0.6"
                android:src="@drawable/ic_time"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvEventTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:alpha="0.6"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="08:40" />
        </LinearLayout>

        <!-- Disclosure Arrow -->
        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/aro_perfil"
            android:backgroundTint="#1AFFFFFF"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_pref"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
